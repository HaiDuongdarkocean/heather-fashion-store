---
config:
  theme: redux
---
erDiagram
    %% USER & AUTH
    User {
        VARCHAR userId PK
        VARCHAR username
        VARCHAR password
        VARCHAR email
        VARCHAR fullName
        VARCHAR phoneNumber
        VARCHAR address
        BOOLEAN isActive
        BOOLEAN isEmailVerified
        BOOLEAN isPhoneVerified
        BOOLEAN isDeleted
        INT failLoginAttempts
        DATETIME lastLogin
        DATETIME createdAt
        DATETIME updatedAt
    }
    Roles {
        VARCHAR roleId PK
        VARCHAR roleName
        TEXT description
        DATETIME createdAt
        DATETIME updatedAt
    }
    UserRoles {
        VARCHAR userId FK
        VARCHAR roleId FK
    }
    permissions {
        VARCHAR permissionId PK
        VARCHAR permissionName
        TEXT description
        DATETIME createdAt
        DATETIME updatedAt
    }
    RolePermissions {
        VARCHAR roleId FK
        VARCHAR permissionId FK
    }

    %% AUDIT & LOG
    auditLog {
        VARCHAR auditLogId PK
        VARCHAR userId FK
        VARCHAR action
        VARCHAR entityType
        VARCHAR entityId
        TEXT description
        DATETIME actionDate
        VARCHAR ipAddress
        VARCHAR userAgent
        DATETIME createdAt
    }
    AuditDiff {
        VARCHAR auditDiffId PK
        VARCHAR auditLogId FK
        VARCHAR fieldName
        TEXT beforeValue
        TEXT afterValue
        DATETIME createdAt
    }
    UserEventLog {
        VARCHAR eventId PK
        VARCHAR userId FK
        ENUM eventType "CLICK, SCROLL, SEARCH, VIEW"
        VARCHAR target
        TEXT metadata
        VARCHAR page
        TEXT referrer
        TEXT userAgent
        TEXT ipAddress
        DATETIME eventTimestamp
        DATETIME createdAt
    }

    %% CUSTOMER SEGMENT
    CustomerSegment {
        VARCHAR segmentId PK
        VARCHAR segmentName
        TEXT description
        BOOLEAN isActive
        DATETIME createdAt
        DATETIME updatedAt
    }
    UserSegment {
        VARCHAR userId FK
        VARCHAR segmentId FK
        DATETIME assignedAt
    }

    %% PRODUCT & CATALOG
    Category {
        VARCHAR categoryId PK
        VARCHAR name
        TEXT description
        DATETIME createdAt
        DATETIME updatedAt
    }
    Subcategory {
        VARCHAR subcategoryId PK
        VARCHAR categoryId FK
        VARCHAR name
        TEXT description
        DATETIME createdAt
        DATETIME updatedAt
    }
    Product {
        VARCHAR productId PK
        VARCHAR subcategoryId FK
        VARCHAR name
        TEXT description
        JSON imageUrls
        DATETIME createdAt
        DATETIME updatedAt
        BOOLEAN isActive
    }
    ProductVariant {
        VARCHAR productVariantId PK
        VARCHAR productId FK
        JSON_VARCHAR color
        JSON_VARCHAR size
        DECIMAL price
        INT stockQuantity
        JSON_VARCHAR imageUrls
        VARCHAR sku
        BOOLEAN isDefault
        BOOLEAN isActive
        DATETIME createdAt
        DATETIME updatedAt
    }
    Tags {
        VARCHAR tagId PK
        VARCHAR tagName
        DATETIME createdAt
        DATETIME updatedAt
    }
    productTags {
        VARCHAR productTagId PK
        VARCHAR productId FK
        VARCHAR tagId FK
    }

    %% COLLECTIONS
    Collection {
        VARCHAR collectionId PK
        VARCHAR name
        VARCHAR slug
        TEXT description
        BOOLEAN isActive
        DATETIME createdAt
        DATETIME updatedAt
    }
    CollectionProduct {
        VARCHAR collectionProductId PK
        VARCHAR collectionId FK
        VARCHAR productId FK
        INT sortOrder
        DATETIME createdAt
        DATETIME updatedAt
    }

    %% DISCOUNT
    Discount {
        VARCHAR discountId PK
        VARCHAR name
        TEXT description
        INT discountPercent
        DATETIME startDate
        DATETIME endDate
        BOOLEAN isActive
        DATETIME createdAt
        DATETIME updatedAt
    }
    VariantDiscount {
        VARCHAR variantDiscountId PK
        VARCHAR productVariantId FK
        VARCHAR discountId FK
        DATETIME appliedAt
        DATETIME createdAt
        DATETIME updatedAt
    }

    %% CART & ORDER
    Cart {
        VARCHAR cartId PK
        VARCHAR userId FK
        DATETIME createdAt
        DATETIME updatedAt
    }
    CartItem {
        VARCHAR cartItemId PK
        VARCHAR cartId FK
        VARCHAR productVariantId FK
        INT quantity
        DATETIME createdAt
        DATETIME updatedAt
    }
    Order {
        VARCHAR orderId PK
        VARCHAR userId FK
        DATETIME orderDate
        ENUM status
        DECIMAL totalAmount
        VARCHAR shippingInfoId FK
        ENUM paymentStatus
        DATETIME createdAt
        DATETIME updatedAt
    }
    OrderItem {
        VARCHAR orderItemId PK
        VARCHAR orderId FK
        VARCHAR productVariantId FK
        INT quantity
        DECIMAL unitPrice
        DECIMAL totalPrice
        DATETIME createdAt
        DATETIME updatedAt
    }
    ShippingInfo {
        VARCHAR shippingInfoId PK
        VARCHAR orderId FK
        VARCHAR recipientName
        VARCHAR address
        VARCHAR phoneNumber
        TEXT notes
        DATETIME createdAt
        DATETIME updatedAt
    }

    %% REVIEW
    ProductReview {
        VARCHAR productReviewId PK
        VARCHAR userId FK
        VARCHAR productId FK
        INT rating
        TEXT comment
        DATETIME createdAt
        DATETIME updatedAt
    }

    %% BLOG & CMS
    BlogCategory {
        VARCHAR categoryId PK
        VARCHAR categoryName
        VARCHAR slug
        TEXT description
        BOOLEAN isActive
        DATETIME createdAt
        DATETIME updatedAt
    }
    Blog {
        VARCHAR blogId PK
        VARCHAR title
        VARCHAR slug
        VARCHAR thumbnailUrl
        TEXT content
        VARCHAR authorId FK
        BOOLEAN isPublished
        DATETIME publishedAt
        DATETIME createdAt
        DATETIME updatedAt
    }
    BlogTag {
        VARCHAR tagId PK
        VARCHAR tagName
        VARCHAR slug
        DATETIME createdAt
        DATETIME updatedAt
    }
    BlogTagMap {
        VARCHAR blogId FK
        VARCHAR tagId FK
        DATETIME createdAt
    }
    Comment {
        VARCHAR commentId PK
        VARCHAR blogId FK
        VARCHAR userId FK
        TEXT content
        VARCHAR parentId FK
        BOOLEAN isApproved
        DATETIME createdAt
        DATETIME updatedAt
    }

    %% BANNER
    Banner {
        VARCHAR bannerId PK
        VARCHAR collectionId FK
        VARCHAR title
        TEXT description
        VARCHAR imageUrl
        VARCHAR linkUrl
        ENUM targetType
        VARCHAR targetId
        VARCHAR position
        BOOLEAN isActive
        DATETIME startDate
        DATETIME endDate
        DATETIME createdAt
        DATETIME updatedAt
    }

    %% RELATIONSHIPS
    User ||--o{ UserRoles : has
    UserRoles ||--o{ Roles : has
    Roles ||--o{ RolePermissions : has
    permissions ||--o{ RolePermissions : has
    User ||--o{ auditLog : performs
    auditLog ||--o{ AuditDiff : has
    User ||--o{ UserEventLog : logs
    User ||--o{ UserSegment : tagged_with
    CustomerSegment ||--o{ UserSegment : has
    Product }o--|| Subcategory : belongs_to
    Subcategory }o--|| Category : belongs_to
    Product ||--|{ ProductVariant : has
    ProductVariant ||--o{ VariantDiscount : has
    VariantDiscount }o--|| Discount : applies
    Product ||--o{ productTags : tagged_with
    Tags ||--o{ productTags : associates
    Collection ||--o{ CollectionProduct : contains
    CollectionProduct }o--|| Product : includes
    Cart ||--o{ CartItem : contains
    CartItem }o--|| ProductVariant : includes
    User ||--|| Cart : has
    User ||--o{ Order : places
    Order ||--|{ OrderItem : contains
    OrderItem }o--|| ProductVariant : includes
    Order ||--|| ShippingInfo : ships_to
    User ||--o{ ProductReview : writes
    ProductReview }o--|| Product : reviews
    User ||--o{ Blog : writes
    BlogCategory ||--o{ Blog : contains
    Blog ||--o{ BlogTagMap : has
    BlogTag ||--o{ BlogTagMap : tagged_with
    Blog ||--o{ Comment : receives
    Comment ||--o{ Comment : replies_to
    User ||--o{ Comment : writes
    Banner ||--o| Collection : links_to