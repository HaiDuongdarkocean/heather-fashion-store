---
config:
  theme: redux
---
erDiagram
    User {
        VARCHAR userId PK
        VARCHAR username
        VARCHAR password
        VARCHAR email
        VARCHAR fullName
        VARCHAR phoneNumber
        VARCHAR address
        ENUM role
        DATETIME createdAt
        DATETIME updatedAt
    }
    Product {
        VARCHAR productId PK
        VARCHAR subcategoryId FK
        VARCHAR name
        TEXT description
        JSON imageUrls
        DATETIME createdAt
        DATETIME updatedAt
        BOOLEAN isActive
    }
    ProductVariant {
        VARCHAR productVariantId PK
        VARCHAR productId FK
        JSON_VARCHAR color
        JSON_VARCHAR size
        DECIMAL price
        INT stockQuantity
        JSON_VARCHAR imageUrls
        VARCHAR sku
        BOOLEAN isDefault
        BOOLEAN isActive
        DATETIME createdAt
        DATETIME updatedAt
    }
    Tags {
        VARCHAR tagId PK
        VARCHAR tagName
        DATETIME createdAt
        DATETIME updatedAt
    }
    productTags {
        VARCHAR productTagId PK
        VARCHAR productId FK
        VARCHAR tagId FK
    }
    Discount {
        VARCHAR discountId PK
        VARCHAR name
        TEXT description
        INT discountPercent
        DATETIME startDate
        DATETIME endDate
        BOOLEAN isActive
        DATETIME createdAt
        DATETIME updatedAt
    }
    VariantDiscount {
        VARCHAR variantDiscountId PK
        VARCHAR productVariantId FK
        VARCHAR discountId FK
        DATETIME appliedAt
        DATETIME createdAt
        DATETIME updatedAt
    }
    Category {
        VARCHAR categoryId PK
        VARCHAR name
        TEXT description
        DATETIME createdAt
        DATETIME updatedAt
    }
    Subcategory {
        VARCHAR subcategoryId PK
        VARCHAR categoryId FK
        VARCHAR name
        TEXT description
        DATETIME createdAt
        DATETIME updatedAt
    }
    Cart {
        VARCHAR cartId PK
        VARCHAR userId FK
        DATETIME createdAt
        DATETIME updatedAt
    }
    CartItem {
        VARCHAR cartItemId PK
        VARCHAR cartId FK
        VARCHAR productVariantId FK
        INT quantity
        DATETIME createdAt
        DATETIME updatedAt
    }
    Order {
        VARCHAR orderId PK
        VARCHAR userId FK
        DATETIME orderDate
        ENUM status
        DECIMAL totalAmount
        VARCHAR shippingInfoId FK
        ENUM paymentStatus
        DATETIME createdAt
        DATETIME updatedAt
    }
    OrderItem {
        VARCHAR orderItemId PK
        VARCHAR orderId FK
        VARCHAR productVariantId FK
        INT quantity
        DECIMAL unitPrice
        DECIMAL totalPrice
        DATETIME createdAt
        DATETIME updatedAt
    }
    ShippingInfo {
        VARCHAR shippingInfoId PK
        VARCHAR orderId FK
        VARCHAR recipientName
        VARCHAR address
        VARCHAR phoneNumber
        TEXT notes
        DATETIME createdAt
        DATETIME updatedAt
    }
    ProductReview {
        VARCHAR productReviewId PK
        VARCHAR userId FK
        VARCHAR productId FK
        INT rating
        TEXT comment
        DATETIME createdAt
        DATETIME updatedAt
    }
    User ||--|| Cart : has
    User ||--o{ Order : places
    User ||--o{ ProductReview : writes
    Product ||--|{ ProductVariant : has
    ProductVariant ||--o{ VariantDiscount : has
    VariantDiscount }o--|| Discount : applies
    Product }o--|| Subcategory : belongs_to
    Product ||--o{ productTags : tagged_with
    Tags ||--o{ productTags : associates
    Subcategory }o--|| Category : belongs_to
    Cart ||--o{ CartItem : contains
    CartItem }o--|| ProductVariant : includes
    Order ||--|{ OrderItem : contains
    OrderItem }o--|| ProductVariant : includes
    Order ||--|| ShippingInfo : ships_to
    ProductReview }o--|| Product : reviews
